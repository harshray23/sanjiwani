
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "The public and private profile data for any user role.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["patient", "doctor", "clinic", "hospital", "diagnostics_centres", "admin"] },
        "verified": { "type": "boolean" },
        "sanjeevaniPoints": { "type": "number" },
        "walletAddress": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "age": { "type": "number" },
        "dob": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["uid", "email", "role"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Unified booking record for consultations, beds, or tests.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "doctorId": { "type": "string" },
        "clinicId": { "type": "string" },
        "hospitalId": { "type": "string" },
        "centreId": { "type": "string" },
        "type": { "type": "string", "enum": ["clinic", "video", "test", "bed"] },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "scheduledAt": { "type": "string" },
        "onChainHash": { "type": "string" },
        "txHash": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "User profiles and account settings."
    },
    "/appointments/{appointmentId}": {
      "schema": "#/backend/entities/Appointment",
      "description": "Global appointment and booking registry."
    }
  }
}
